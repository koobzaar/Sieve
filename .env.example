# Telegram user account API credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Private notification bot and administrator Telegram numeric user ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=

# Required for evaluation and natural-language preferences
GEMINI_API_KEY=

# Ready-to-configure Pelando + private preference bot setup.
# Start a private conversation with your bot, fill the credentials above, then run.
SIEVE_PREFERENCES_ENABLED=true
SIEVE_PELANDO_ENABLED=true
# Enable after running the one-time auth-telegram command.
SIEVE_TELEGRAM_ENABLED=false

# Common settings (advanced settings stay in config/config.yaml).
SIEVE_GEMINI_MODEL=gemini-3.5-flash-lite
SIEVE_GEMINI_EVALUATION_ENABLED=true
SIEVE_BM25_THRESHOLD=2.0
SIEVE_BM25_AUTO_FORWARD_THRESHOLD=7.0
SIEVE_BM25_AUTO_FORWARD_MODE=shadow
SIEVE_LOG_LEVEL=INFO

# Optional complete local config, ignored by Git:
# SIEVE_CONFIG_FILE=./config/config.local.yaml
